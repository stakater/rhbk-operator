{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "rhbk-operator dependency updates — grouped, scheduled, verified by CI. House policy adapted from kube-ward (see CLAUDE.md).",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitTypeAll(build)",
    ":enableVulnerabilityAlertsWithLabel(security)"
  ],
  "labels": [
    "dependencies"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "osvVulnerabilityAlerts": true,
  "prConcurrentLimit": 8,
  "prHourlyLimit": 4,
  "packageRules": [
    {
      "description": "Group Go minor+patch bumps into one PR to cut noise.",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "go modules"
    },
    {
      "description": "Go toolchain: the Dockerfile golang image and go.mod's go directive move together; we always build on a supported Go release.",
      "matchPackageNames": [
        "go",
        "golang"
      ],
      "groupName": "Go toolchain"
    },
    {
      "description": "A new Go minor/major changes go.mod's minimum and every builder — approve it explicitly.",
      "matchPackageNames": [
        "go",
        "golang"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "golang.org/x/* together.",
      "matchPackageNames": [
        "golang.org/x/**"
      ],
      "groupName": "golang.org/x"
    },
    {
      "description": "Kubernetes libraries, controller-runtime/tools, OpenShift API and prometheus-operator move together (controller-runtime pins a k8s minor; openshift/api and prometheus-operator pull k8s.io/*). A coordinated upgrade — approved explicitly and verified with the e2e suite, never bundled into routine bumps.",
      "matchPackageNames": [
        "k8s.io/**",
        "sigs.k8s.io/controller-runtime",
        "sigs.k8s.io/controller-tools",
        "github.com/openshift/api",
        "github.com/prometheus-operator/prometheus-operator"
      ],
      "groupName": "Kubernetes + controller-runtime + OpenShift API",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group GitHub Actions bumps.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "Major bumps stay separate and get an explicit label — the human review path.",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major-update"
      ]
    },
    {
      "description": "Build tools pinned in the Makefile.",
      "matchFileNames": [
        "Makefile"
      ],
      "groupName": "build tools (Makefile)"
    }
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "UTC",
  "vulnerabilityAlerts": {
    "schedule": [
      "at any time"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "golangci-lint pinned in the Makefile (must support the Go toolchain we build with)",
      "matchStrings": [
        "GOLANGCI_LINT_VERSION \\?= (?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases",
      "managerFilePatterns": [
        "/^Makefile$/"
      ]
    },
    {
      "customType": "regex",
      "description": "operator-sdk pinned in the Makefile",
      "matchStrings": [
        "OPERATOR_SDK_VERSION \\?= (?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "operator-framework/operator-sdk",
      "datasourceTemplate": "github-releases",
      "managerFilePatterns": [
        "/^Makefile$/"
      ]
    },
    {
      "customType": "regex",
      "description": "kustomize pinned in the Makefile",
      "matchStrings": [
        "KUSTOMIZE_VERSION \\?= (?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "kubernetes-sigs/kustomize",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^kustomize/(?<version>v\\S+)$",
      "managerFilePatterns": [
        "/^Makefile$/"
      ]
    },
    {
      "customType": "regex",
      "description": "controller-tools pinned in the Makefile",
      "matchStrings": [
        "CONTROLLER_TOOLS_VERSION \\?= (?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "kubernetes-sigs/controller-tools",
      "datasourceTemplate": "github-releases",
      "managerFilePatterns": [
        "/^Makefile$/"
      ]
    }
  ]
}
